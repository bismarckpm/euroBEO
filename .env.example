# Conexión a PostgreSQL. En Docker Compose el servicio app usa el host `db`.
DATABASE_URL=postgresql://eurobeo:eurobeo@localhost:5433/eurobeo

# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres.
SESSION_SECRET=cambia-este-secreto-por-uno-largo-de-al-menos-32

# Opcional. Si falta, la aplicación arranca y la normalización con IA queda deshabilitada.
OPENAI_API_KEY=

# Opcionales hasta el archivo en Google Drive. Si se informan, se validan al arrancar.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_FOLDER_ID=

# Puerto HTTP de la aplicación.
PORT=3000
