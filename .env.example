# Conexión a PostgreSQL. En Docker Compose el servicio app usa el host `db`.
DATABASE_URL=postgresql://eurobeo:eurobeo@localhost:5433/eurobeo

# Secreto para firmar la cookie de sesión. Mínimo 32 caracteres.
SESSION_SECRET=cambia-este-secreto-por-uno-largo-de-al-menos-32

# Opcional. Si falta, la aplicación arranca y la normalización con IA queda deshabilitada.
OPENAI_API_KEY=

# Google Drive. Si faltan, la aplicación arranca, genera los documentos y los deja pendientes de subir.
# Cuenta de servicio (JSON en una sola línea) o, en su lugar, las tres variables OAuth.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
# Id de la carpeta raíz. GOOGLE_DRIVE_FOLDER_ID se acepta como alias.
DRIVE_ROOT_FOLDER_ID=
# true también sube el PDF. Por defecto solo se sube el .docx, sin convertirlo.
DRIVE_UPLOAD_PDF=false

# Puerto HTTP de la aplicación.
PORT=3000
