generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Única usuaria de la herramienta. `title` es el cargo que firma los memorándums.
model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  name         String
  title        String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Auditoría transversal: acción, entidad, identificador, valor anterior, valor nuevo y fecha.
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String
  before    Json?
  after     Json?
  createdAt DateTime @default(now())
}

/// Nombre oficial del salón, tal como debe imprimirse en la B.E.O.
model Salon {
  id        String       @id @default(cuid())
  name      String       @unique
  aliases   SalonAlias[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

/// Variante de un salón. `normalized` es la clave de búsqueda.
model SalonAlias {
  id         String   @id @default(cuid())
  salonId    String
  salon      Salon    @relation(fields: [salonId], references: [id], onDelete: Cascade)
  label      String
  normalized String   @unique
  createdAt  DateTime @default(now())

  @@index([salonId])
}

/// Encabezado de sección del presupuesto y sección destino de la B.E.O.
model SectionMapping {
  id         String   @id @default(cuid())
  header     String
  normalized String   @unique
  section    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

/// Ítem frecuente. Sirve cuando el encabezado de sección no alcanza para clasificarlo.
model CatalogItem {
  id          String   @id @default(cuid())
  description String
  normalized  String   @unique
  category    String
  section     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Texto fijo vigente de la B.E.O. La clave es estable: instrucciones, preparación o iniciales.
model FixedText {
  key       String   @id
  label     String
  body      String
  updatedAt DateTime @updatedAt
}

/// Tipo de memorándum: destinatario, cuerpo con variables y palabras que lo disparan.
model MemoType {
  id           String   @id @default(cuid())
  name         String   @unique
  recipient    String
  company      String
  reference    String
  body         String
  keywords         String[]
  templateFile     String
  excludeSetupDays Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  memos            Memo[]
}

/// Último correlativo emitido. `key` identifica la serie (B.E.O.).
model Sequence {
  key        String   @id
  lastNumber Int
  year       Int
  updatedAt  DateTime @updatedAt
}

/// Evento leído de un presupuesto. Varias versiones comparten el mismo evento.
model Event {
  id        String   @id @default(cuid())
  title     String
  company   String
  locator   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  budgets   Budget[]
  beos      Beo[]
  memos     Memo[]
  documents GeneratedDocument[]

  @@index([locator, company])
  @@index([company])
  @@index([title])
  @@index([locator])
}

/// Una carga del PDF. `version` sube cuando el mismo localizador y cliente se vuelven a subir.
model Budget {
  id              String          @id @default(cuid())
  eventId         String
  event           Event           @relation(fields: [eventId], references: [id], onDelete: Cascade)
  version         Int
  fileName        String
  originalPdf     Bytes
  status          String
  justification   String?
  subtotalCents   Int?
  itemsSumCents   Int
  differenceCents Int?
  warnings        String[]
  triggers        String[] @default([])
  structureErrors Json
  createdAt       DateTime        @default(now())
  days            BudgetDay[]
  benefits        BudgetBenefit[]

  @@unique([eventId, version])
}

/// Día o rango de fechas del presupuesto.
model BudgetDay {
  id       String        @id @default(cuid())
  budgetId String
  budget   Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  position Int
  dates    String[]
  raw      String
  blocks   BudgetBlock[]

  @@index([budgetId])
  @@index([dates], type: Gin)
}

/// Bloque de montaje, evento, desmontaje u otro dentro de un día.
model BudgetBlock {
  id              String       @id @default(cuid())
  dayId           String
  day             BudgetDay    @relation(fields: [dayId], references: [id], onDelete: Cascade)
  position        Int
  kind            String
  rawTitle        String
  salonRaw        String?
  salonName       String?
  salonStatus     String
  schedule        String?
  scheduleStatus  String
  setup           String?
  setupStatus     String
  pax             Int?
  paxStatus       String
  nights          Int?
  rentRegular     Int?
  rentNet         Int?
  discountLabel   String?
  courtesy        Boolean
  page            Int
  items           BudgetItem[]

  @@index([dayId])
}

/// Ítem leído en una sección del bloque.
model BudgetItem {
  id              String      @id @default(cuid())
  blockId         String
  block           BudgetBlock @relation(fields: [blockId], references: [id], onDelete: Cascade)
  position        Int
  sectionHeader   String
  sectionTarget   String?
  sectionStatus   String
  qty             Int
  description     String
  nights          Int
  unitPriceCents  Int?
  totalCents      Int?
  flags           String[]

  @@index([blockId])
}

/// Línea de la sección BENEFICIOS.
model BudgetBenefit {
  id       String @id @default(cuid())
  budgetId String
  budget   Budget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  position Int
  text     String

  @@index([budgetId])
}

/// Texto libre ya confirmado por la asistente. La clave es la tarea más el texto normalizado.
model LearnedNormalization {
  id             String   @id @default(cuid())
  task           String
  normalizedText String
  sourceText     String
  result         Json
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([task, normalizedText])
}

/// Propuesta de B.E.O. `draft` es borrador y `generated` es la ya emitida.
model Beo {
  id          String     @id @default(cuid())
  eventId     String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  position    Int
  status      String
  date        String
  salon       String
  kind        String
  needsReview Boolean    @default(false)
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  fields      BeoField[]
  lines       BeoLine[]
  documents   GeneratedDocument[]

  @@index([eventId])
  @@index([date])
}

/// Memorándum del evento. El número lo escribe la asistente; la versión sube al regenerar.
model Memo {
  id         String      @id @default(cuid())
  eventId    String
  event      Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  memoTypeId String
  memoType   MemoType    @relation(fields: [memoTypeId], references: [id], onDelete: Restrict)
  number     String?
  status     String
  version    Int         @default(1)
  stale      Boolean     @default(false)
  manual     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  fields     MemoField[]
  documents  GeneratedDocument[]

  @@unique([eventId, memoTypeId])
  @@index([eventId])
}

/// Campo trazable del memorándum: valor, estado y origen.
model MemoField {
  id     String  @id @default(cuid())
  memoId String
  memo   Memo    @relation(fields: [memoId], references: [id], onDelete: Cascade)
  key    String
  value  String?
  status String
  source String

  @@unique([memoId, key])
  @@index([memoId])
}

/// Campo trazable de la propuesta: valor, estado y origen.
model BeoField {
  id     String  @id @default(cuid())
  beoId  String
  beo    Beo     @relation(fields: [beoId], references: [id], onDelete: Cascade)
  key    String
  value  String?
  status String
  source String

  @@index([beoId])
}

/// Línea editable de alimentos, personal u otra sección.
model BeoLine {
  id             String @id @default(cuid())
  beoId          String
  beo            Beo    @relation(fields: [beoId], references: [id], onDelete: Cascade)
  position       Int
  section        String
  groupName      String
  qty            Int
  description    String
  unitPriceCents Int?
  text           String
  status         String
  source         String

  @@index([beoId])
}

/// Llamada a la IA con el fragmento ya enmascarado y el resultado de la validación.
model AiCallLog {
  id        String   @id @default(cuid())
  task      String
  fragment  String
  response  Json?
  valid     Boolean
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/// Versión de una plantilla Word. Los documentos ya emitidos conservan la suya.
model Template {
  id        String              @id @default(cuid())
  type      String
  version   Int
  filePath  String
  active    Boolean             @default(false)
  createdAt DateTime            @default(now())
  documents GeneratedDocument[]

  @@unique([type, version])
}

/// B.E.O. generada: número, archivos y plantilla con la que se llenó.
model GeneratedDocument {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  beoId       String?
  beo         Beo?     @relation(fields: [beoId], references: [id], onDelete: SetNull)
  memoId      String?
  memo        Memo?    @relation(fields: [memoId], references: [id], onDelete: SetNull)
  kind        String
  version     Int
  number      String
  fileName    String
  docxPath    String
  pdfPath     String
  sha256      String
  exceedsPage   Boolean  @default(false)
  templateId    String
  template      Template @relation(fields: [templateId], references: [id])
  driveStatus   String   @default("pendiente")
  driveUrl      String?
  driveAttempts Int      @default(0)
  snapshot      Json?
  createdAt     DateTime @default(now())

  @@index([eventId])
  @@index([number])
}
